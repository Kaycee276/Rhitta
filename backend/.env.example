PORT=4000

# ==============================================================================
# Database Configuration (Turso Cloud SQLite / LibSQL)
# ==============================================================================
# For Local Development (SQLite file):
DATABASE_URL=file:./dev.db

# For Turso Cloud Database:
# 1. Run: turso db show <db-name> --url
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
# 2. Run: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# ==============================================================================
# Stellar & Soroban Configuration
# ==============================================================================
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# (Optional) Deployed Soroban Rhitta Contract ID (starts with 'C...')
STELLAR_CONTRACT_ID=

# Publisher Stellar Account (Keypair)
# Secret key begins with 'S' (e.g., SDVZOL...)
STELLAR_SECRET_KEY=S...
# Public key begins with 'G' (e.g., GBELXT...)
STELLAR_PUBLIC_KEY=G...

# ==============================================================================
# Optional File Storage (Falls back to local static /uploads if left empty)
# ==============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
