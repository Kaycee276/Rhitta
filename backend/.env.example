PORT=4000

# Database Configuration (SQLite / Turso LibSQL Cloud DB)
# For Local Development: file:dev.db
# For Turso Cloud DB: libsql://<your-db>-<your-org>.turso.io
DATABASE_URL=file:dev.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Stellar & Soroban Configuration
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_CONTRACT_ID=

# Publisher Stellar Keys
STELLAR_SECRET_KEY=S...
STELLAR_PUBLIC_KEY=G...

# Optional Storage (falls back to local /uploads if not set)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
