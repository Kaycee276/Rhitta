{
	"name": "rhitta-backend",
	"version": "0.1.0",
	"private": true,
	"description": "TypeScript backend for Rhitta — Stellar & Soroban music platform bridge",
	"main": "dist/index.js",
	"type": "commonjs",
	"scripts": {
		"dev": "ts-node-dev --respawn --transpile-only src/index.ts",
		"build": "tsc -p tsconfig.json",
		"lint": "tsc --noEmit",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\"",
		"start": "tsx src/index.ts",
		"postinstall": "prisma generate",
		"db:push": "tsx src/scripts/dbPush.ts"
	},
	"dependencies": {
		"@libsql/client": "^0.8.1",
		"@prisma/adapter-libsql": "^6.4.1",
		"@prisma/client": "^6.4.1",
		"@stellar/stellar-sdk": "^17.4.0",
		"@supabase/supabase-js": "^2.84.0",
		"cors": "^2.8.5",
		"dotenv": "^16.0.0",
		"express": "^4.18.2",
		"multer": "^2.0.2",
		"music-metadata": "^11.10.3",
		"tsx": "^4.23.15",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@types/express": "^4.17.17",
		"@types/multer": "^1.4.7",
		"@types/node": "^20.4.2",
		"@types/ws": "^8.5.4",
		"prettier": "^3.9.10",
		"prisma": "^6.4.1",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.1.6"
	}
}
